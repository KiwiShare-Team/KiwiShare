# Secret signing key for JWT session tokens (Replace with a cryptographically secure key)
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE

# Node Environment
NODE_ENV=development

# Firebase configuration variables (Optional, defaults to Local Admin Emulator)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
GOOGLE_APPLICATION_CREDENTIALS=firebase-adminsdk.json

# Resend Email Configuration (Optional, for real OTP delivery)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=KiwiShare <no-reply@yourdomain.co.nz>


