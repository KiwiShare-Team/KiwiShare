# Secret signing key for JWT session tokens (Replace with a cryptographically secure key)
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE

# Node Environment
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/kiwishare
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/kiwishare_test

# Resend Email Configuration (Optional, for real OTP delivery)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=KiwiShare <no-reply@yourdomain.co.nz>
