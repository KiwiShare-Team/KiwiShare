# Required: random JWT signing secret, at least 32 characters. Generate and
# store it in the deployment secret manager; never commit the real value.
# The server refuses to start when this is blank, short, or a known placeholder.
JWT_SECRET=

# Node Environment
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@kiwishare.ll1go7c.mongodb.net/kiwishare_prod?appName=kiwishare
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@kiwishare.ll1go7c.mongodb.net/kiwishare_test?appName=kiwishare

# Resend Email Configuration (Optional, for real OTP delivery)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=KiwiShare <no-reply@yourdomain.co.nz>
# Cloudflare R2 Storage Configuration (S3 Compatible)
R2_ACCOUNT_ID=xxx
R2_BUCKET=kiwishare
R2_ENDPOINT=https://cdc04de9bc4c6a41b5003758e505a0d1.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_PUBLIC_URL=https://assets.kiwishare.online

# Optional comma-separated additions to the server's built-in chat moderation list
CHAT_BLOCKED_TERMS=

# Firebase Admin credentials for FCM push delivery. Prefer a secret file via
# GOOGLE_APPLICATION_CREDENTIALS; Render may use a single-line JSON secret.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
